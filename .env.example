GEMINI_API_KEY=your_api_key_here

# 可选：默认 descriptions.txt
DESCRIPTIONS_FILE=descriptions.txt

# 可选：默认 generated_videos
OUTPUT_DIR=generated_videos

# 可选：AI Studio 视频页（浏览器自动化）
AI_STUDIO_VIDEO_URL=https://aistudio.google.com/generate-video

# 可选：仅用于日志标注你期望的模型名（实际以网页 UI 为准）
EXPECTED_MODEL_NAME=veo-3.1-generate-preview

# 可选：并发限制 1~2
CONCURRENT_VIDEOS=1

# 可选：轮询间隔和最大等待
POLL_INTERVAL_MS=5000
MAX_WAIT_MS=720000
# 按业务需求，点击生成后固定等待时长（默认 3 分钟）
WAIT_AFTER_GENERATE_MS=180000

# 可选：连接已启动的 Chrome 调试端口
CDP_URL=http://localhost:9222
# 可选：若 CDP_URL 在你机器上偶发 400，可直接填 ws 端点覆盖
# 可从 http://localhost:9222/json/version 的 webSocketDebuggerUrl 获取
CDP_WS_ENDPOINT=

# 如页面更新导致无法定位控件，可在此覆写选择器
PROMPT_SELECTOR=textarea[placeholder*="Describe"], textarea, div[contenteditable="true"]
GENERATE_BUTTON_SELECTOR=button:has-text("Generate"), button:has-text("Create"), button:has-text("生成")
DONE_INDICATOR_SELECTOR=button:has-text("Download"), a:has-text("Download"), button:has-text("下载"), a:has-text("下载")
DOWNLOAD_BUTTON_SELECTOR=button:has-text("Download"), a:has-text("Download"), button:has-text("下载"), a:has-text("下载")
# 页面偶发 Frame detached 时的重试次数
MAX_NAVIGATE_RETRY=3
